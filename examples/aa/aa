#!/usr/bin/env python3
"""aa — Artificial Analysis 익명 읽기 CLI (any2cli).

데이터 표면 (2026-09-22 라이브 프로브 확정):
  - JSON API 없음, XHR 없음 — /models/<slug> SSR HTML의 Next.js flight
    (self.__next_f.push)에 currentModel 풀 레코드(80+ 필드)가 인라인.
  - 추출: flight 청크 JSON 언이스케이프 → '"currentModel":{' brace-match → json.loads.
  - /models 인덱스 카드 href → slug 목록.

currentModel 핵심 필드 (실측):
  intelligenceIndex, performanceByPromptType{medium,long,hundredK,...},
  intelligenceIndexTimePerTask, intelligenceIndexEvaluations[]{slug,score,
  outputTokensPerTask,costPerTask,timePerTask}, outputSpeedVariance,
  timeToFirstChunkVariance, endToEndResponseTime, timeToFirstAnswerToken,
  price1m*, 벤치마크 점수(hle/gpqa/terminalBench21/...), parameters, license.

Exit codes: 0 ok / 2 network / 3 empty / 4 not-on-AA(404)
"""
import argparse, json, re, sys, time, os
import urllib.request, urllib.error

UA = 'aa-cli/1.0 (anonymous Artificial Analysis reader; personal use)'
BASE = 'https://artificialanalysis.ai'
CACHE_DIR = os.environ.get('AA_CACHE', os.path.expanduser('~/.cache/aa-cli'))
DEFAULT_TTL = 3600

def log(*a):
    print(*a, file=sys.stderr)

def http_get(url, ttl=DEFAULT_TTL, fresh=False):
    os.makedirs(CACHE_DIR, exist_ok=True)
    key = re.sub(r'[^A-Za-z0-9]', '_', url)[-160:]
    path = os.path.join(CACHE_DIR, key)
    if not fresh and os.path.exists(path) and time.time() - os.path.getmtime(path) < ttl:
        return open(path, encoding='utf-8', errors='replace').read(), 'cache'
    req = urllib.request.Request(url, headers={'User-Agent': UA})
    for attempt in range(2):
        try:
            body = urllib.request.urlopen(req, timeout=40).read().decode('utf-8', 'replace')
            if len(body) < 500:
                raise ValueError(f'suspicious short body ({len(body)}B)')
            tmp = path + '.tmp'
            open(tmp, 'w', encoding='utf-8').write(body)
            os.replace(tmp, path)
            return body, 'net'
        except (urllib.error.HTTPError, urllib.error.URLError, ValueError):
            if attempt == 1:
                raise
            time.sleep(2)
    raise RuntimeError('unreachable')

def flight_payload(html):
    chunks = re.findall(r'self\.__next_f\.push\(\[1,"((?:[^"\\]|\\.)*)"\]\)', html)
    return ''.join(json.loads('"' + c + '"') for c in chunks)

def brace_match(s, start):
    depth = 0; i = start; instr = False; esc = False
    while i < len(s):
        c = s[i]
        if instr:
            if esc: esc = False
            elif c == '\\': esc = True
            elif c == '"': instr = False
        else:
            if c == '"': instr = True
            elif c == '{': depth += 1
            elif c == '}':
                depth -= 1
                if depth == 0: return i
        i += 1
    return -1

def extract_model_record(html, slug):
    fp = flight_payload(html)
    anchor = fp.find('"currentModel":{')
    if anchor < 0:
        return None
    j = fp.find('{', anchor + len('"currentModel"'))
    end = brace_match(fp, j)
    if end < 0:
        return None
    rec = json.loads(fp[j:end + 1])
    if rec.get('slug') and rec['slug'] != slug:
        log(f'warn: record slug {rec.get("slug")} != requested {slug}')
    return rec

def index_slugs(body):
    slugs = sorted(set(re.findall(r'/models/([a-z0-9][a-z0-9\.\-]{2,})["\'<\s]', body)))
    return [s for s in slugs if s not in ('capabilities', 'recommend')]

# ---------- 표현 ----------
def cw(s):
    return sum(2 if ord(c) > 0x2E7F else 1 for c in str(s))

def pad(s, w):
    return str(s) + ' ' * max(0, w - cw(s))

def render(rows, cols, fmt, title=None):
    if fmt == 'json':
        print(json.dumps(rows, ensure_ascii=False, indent=2)); return
    if not rows:
        print('(no rows)', file=sys.stderr); sys.exit(3)
    if fmt == 'jsonl':
        for r in rows: print(json.dumps(r, ensure_ascii=False))
        return
    if fmt == 'md':
        if title: print(f'## {title}\n')
        print('| ' + ' | '.join(cols) + ' |')
        print('|' + '|'.join(['---'] * len(cols)) + '|')
        for r in rows:
            print('| ' + ' | '.join(str(r.get(c, '')) for c in cols) + ' |')
        return
    if title: print(title)
    widths = [cw(c) for c in cols]
    for r in rows:
        for i, c in enumerate(cols):
            widths[i] = max(widths[i], cw(r.get(c, '')))
    print('  '.join(pad(c, w) for c, w in zip(cols, widths)).rstrip())
    print('  '.join('-' * w for w in widths))
    for r in rows:
        print('  '.join(pad(r.get(c, ''), w) for c, w in zip(cols, widths)).rstrip())

def f2(v):
    return round(v, 2) if isinstance(v, (int, float)) else v

def summary(rec):
    pb = rec.get('performanceByPromptType') or {}
    med = pb.get('medium') or {}
    lon = pb.get('long') or {}
    return {
        'name': rec.get('shortName') or rec.get('name'),
        'ii': f2(rec.get('intelligenceIndex')),
        'out_tps': f2((rec.get('performanceByPromptType', {}).get('long') or {}).get('medianOutputSpeed')),
        'ttft_s': f2(med.get('medianTimeToFirstChunk')),
        'e2e_500tok_s': f2((rec.get('endToEndResponseTime') or {}).get('median')),
        'ii_time_per_task_s': f2(rec.get('intelligenceIndexTimePerTask')),
        'ii_cost_per_task': f2((rec.get('intelligenceIndexCostPerTask') or {}).get('total')),
        'in_usd': rec.get('price1mInputTokens'),
        'out_usd': rec.get('price1mOutputTokens'),
        'ctx': rec.get('contextWindowTokens'),
        'params_b': rec.get('parameters'),
        'active_b': rec.get('inferenceParametersActiveBillions'),
        'license': rec.get('licenseName'),
        'released': rec.get('releaseDate'),
    }

# ---------- 명령 ----------
def get_rec(slug, ttl, fresh):
    body, src = http_get(f'{BASE}/models/{slug}', ttl, fresh)
    rec = extract_model_record(body, slug)
    if not rec:
        raise RuntimeError(f'currentModel record not found in SSR for {slug}')
    return rec, src

def cmd_models(args):
    body, src = http_get(f'{BASE}/models', args.cache_ttl, args.fresh)
    slugs = index_slugs(body)
    log(f'engine={src} slugs={len(slugs)}')
    render([{'slug': s} for s in slugs], ['slug'], args.format, 'Artificial Analysis models')

def cmd_model(args):
    rec, src = get_rec(args.slug, args.cache_ttl, args.fresh)
    log(f'engine={src}')
    if args.raw:
        print(json.dumps(rec, ensure_ascii=False, indent=2)); return
    if args.format == 'table':
        rows = [{'field': k, 'value': json.dumps(v, ensure_ascii=False) if isinstance(v, (dict, list)) else v}
                for k, v in rec.items()]
        render(rows, ['field', 'value'], 'table', rec.get('name'))
    else:
        render(rec, list(rec.keys()), args.format)

def cmd_summary(args):
    rows = []
    for s in args.slugs:
        try:
            rec, src = get_rec(s, args.cache_ttl, args.fresh)
            row = summary(rec); row['engine'] = src; rows.append(row)
        except urllib.error.HTTPError as e:
            rows.append({'name': s, 'error': f'HTTP {e.code}'})
        except Exception as e:
            rows.append({'name': s, 'error': str(e)[:70]})
    cols = ['name', 'ii', 'out_tps', 'ttft_s', 'e2e_500tok_s', 'ii_time_per_task_s',
            'ii_cost_per_task', 'in_usd', 'out_usd', 'ctx', 'params_b', 'active_b', 'released', 'error']
    render(rows, cols, args.format, 'AA summary (long-prompt t/s · II task time/cost)')

def cmd_tasks(args):
    """벤치마크별 작업 소요시간·비용 (intelligenceIndexEvaluations)."""
    rows = []
    for s in args.slugs:
        try:
            rec, src = get_rec(s, args.cache_ttl, args.fresh)
        except urllib.error.HTTPError as e:
            rows.append({'model': s, 'bench': f'HTTP {e.code}', 'score': '', 'tok_per_task': '', 'cost_per_task': '', 'time_per_task_s': ''})
            continue
        name = rec.get('shortName') or s
        for ev in rec.get('intelligenceIndexEvaluations') or []:
            rows.append({
                'model': name, 'bench': ev.get('slug'), 'score': f2(ev.get('score')),
                'tok_per_task': int(ev.get('outputTokensPerTask') or 0),
                'cost_per_task': f2(ev.get('costPerTask')),
                'time_per_task_s': f2(ev.get('timePerTask'))})
    render(rows, ['model', 'bench', 'score', 'tok_per_task', 'cost_per_task', 'time_per_task_s'],
           args.format, 'AA time/cost per Intelligence Index task')

def cmd_speed(args):
    """프롬프트 타입별·분산별 속도/지연."""
    rows = []
    for s in args.slugs:
        try:
            rec, _ = get_rec(s, args.cache_ttl, args.fresh)
        except urllib.error.HTTPError as e:
            rows.append({'model': s, 'ptype': f'HTTP {e.code}'}); continue
        name = rec.get('shortName') or s
        for ptype, v in (rec.get('performanceByPromptType') or {}).items():
            rows.append({'model': name, 'ptype': ptype,
                         'out_tps': f2(v.get('medianOutputSpeed')),
                         'ttfc_s': f2(v.get('medianTimeToFirstChunk')),
                         'ttfat_s': f2(v.get('medianTimeToFirstAnswerToken')),
                         'e2e_s': f2(v.get('medianEndToEndResponseTime'))})
        var = rec.get('outputSpeedVariance') or {}
        if var:
            rows.append({'model': name, 'ptype': 'speed_variance',
                         'out_tps': json.dumps({k: f2(x) for k, x in var.items()}, ensure_ascii=False)})
    render(rows, ['model', 'ptype', 'out_tps', 'ttfc_s', 'ttfat_s', 'e2e_s'], args.format,
           'AA speed by prompt type (median)')

def cmd_search(args):
    body, src = http_get(f'{BASE}/models', args.cache_ttl, args.fresh)
    slugs = index_slugs(body)
    q = args.query.lower()
    hits = [s for s in slugs if q in s]
    log(f'engine={src} hits={len(hits)}')
    if not hits:
        print('no matching slug — try: aa models', file=sys.stderr); sys.exit(3)
    render([{'slug': s} for s in hits], ['slug'], args.format, f'AA search: {args.query}')

def main():
    ap = argparse.ArgumentParser(prog='aa', description='Anonymous Artificial Analysis reader (any2cli)')
    ap.add_argument('--version', action='version', version='aa 2.0')
    sub = ap.add_subparsers(dest='cmd', required=True)

    def common(sp, positional=None, nargs=None):
        sp.add_argument('--format', choices=['table', 'json', 'jsonl', 'md'], default='table')
        sp.add_argument('--cache-ttl', type=int, default=DEFAULT_TTL)
        sp.add_argument('--fresh', action='store_true')
        if positional:
            if nargs:
                sp.add_argument(positional, nargs=nargs, help='model slug(s)')
            else:
                sp.add_argument(positional, help='model slug / query')

    for name, fn, kw in [('models', cmd_models, {}), ('search', cmd_search, {'positional': 'query'}),
                         ('model', cmd_model, {'positional': 'slug'}),
                         ('summary', cmd_summary, {'positional': 'slugs', 'nargs': '+'}),
                         ('tasks', cmd_tasks, {'positional': 'slugs', 'nargs': '+'}),
                         ('speed', cmd_speed, {'positional': 'slugs', 'nargs': '+'})]:
        sp = sub.add_parser(name)
        common(sp, **kw)
        if name == 'model':
            sp.add_argument('--raw', action='store_true', help='print full currentModel record JSON')
        sp.set_defaults(fn=fn)

    args = ap.parse_args()
    try:
        args.fn(args)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            print(f'not on Artificial Analysis (404): {getattr(args, "slug", None) or getattr(args, "slugs", "?")}',
                  file=sys.stderr); sys.exit(4)
        print(f'HTTP {e.code}', file=sys.stderr); sys.exit(2)
    except urllib.error.URLError as e:
        print(f'network: {e.reason}', file=sys.stderr); sys.exit(2)
    except RuntimeError as e:
        print(str(e), file=sys.stderr); sys.exit(3)

if __name__ == '__main__':
    main()
