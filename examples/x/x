# ---------------------------------------------------------------- helpers

def die(code, msg):
    print(msg, file=sys.stderr)
    sys.exit(code)


def cache_get(key, ttl):
    p = os.path.join(CACHE_DIR, hashlib.sha256(key.encode()).hexdigest() + ".json")
    if ttl > 0 and os.path.exists(p):
        try:
            with open(p) as f:
                blob = json.load(f)
            if time.time() - blob["ts"] <= ttl:
                return blob["body"], blob.get("engine", "")
        except Exception:
            pass
    return None, None


def cache_put(key, body, engine=""):
    os.makedirs(CACHE_DIR, exist_ok=True)
    p = os.path.join(CACHE_DIR, hashlib.sha256(key.encode()).hexdigest() + ".json")
    try:
        with open(p, "w") as f:
            json.dump({"ts": time.time(), "url": key, "engine": engine, "body": body}, f)
    except Exception:
        pass


def http_json(url, timeout=20):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8", "ignore"))


def cdp_eval(js, retries=2):
    """Evaluate JS in the CDP browser. Returns python object or dies with code 3."""
    for i in range(retries + 1):
        p = subprocess.run(
            ["agent-browser", "--cdp", CDP, "eval", js],
            capture_output=True, text=True, timeout=60)
        out = (p.stdout or "").strip()
        if out.startswith('"'):
            try:
                return json.loads(json.loads(out))
            except Exception:
                pass
        if out.startswith("{") or out.startswith("["):
            try:
                return json.loads(out)
            except Exception:
                pass
        if p.returncode != 0 and i == retries:
            die(3, f"engine=cdp: agent-browser failed: {(p.stderr or out)[:200]}")
        time.sleep(1.5)
    return None


def cdp_open(url):
    subprocess.run(["agent-browser", "--cdp", CDP, "open", url],
                   capture_output=True, timeout=60)


NUM = {"K": 1e3, "M": 1e6, "B": 1e9, "만": 1e4, "천": 1e3, "억": 1e8}

def parse_count(s):
    """'8.6만' '440+' '1.9만' '18.6K' '29' -> int (approx suffix + becomes lower bound)."""
    if not s:
        return None
    s = s.strip().rstrip("+").replace(",", "")
    m = re.match(r"^([\d.]+)\s*([KMB만천억])?$", s)
    if not m:
        return None
    v = float(m.group(1))
    suf = m.group(2)
    if suf:
        v *= NUM.get(suf, 1)
    return int(v)


def fmt_num(n):
    if n is None:
        return "·"
    if n >= 1e8:
        return f"{n/1e8:.1f}억"
    if n >= 1e4:
        return f"{n/1e4:.1f}만"
    return str(n)


# ---------------------------------------------------------------- engines

TWEET_ID_RE = re.compile(r"(?:status|statuses)/(\d{15,25})")
HANDLE_RE = re.compile(r"^@?([A-Za-z0-9_]{1,15})$")


def parse_tweet_id(s):
    m = TWEET_ID_RE.search(s)
    if m:
        return m.group(1)
    if re.match(r"^\d{15,25}$", s):
        return s
    return None


def parse_handle(s):
    s = s.strip().rstrip("/")
    m = HANDLE_RE.match(s)
    if m:
        return m.group(1)
    m = re.search(r"(?:x|twitter)\.com/([A-Za-z0-9_]{1,15})(?:/|$|\?)", s)
    if m and m.group(1).lower() not in ("i", "search", "home", "explore", "settings"):
        return m.group(1)
    return None


def synd_tweet(tid):
    """cdn.syndication tweet-result. Returns record or None."""
    url = f"https://cdn.syndication.twimg.com/tweet-result?id={tid}&token=x&lang=en"
    try:
        d = http_json(url)
    except urllib.error.HTTPError as e:
        if e.code in (400, 404):
            return None
        raise
    u = d.get("user") or {}
    return {
        "id": d.get("id_str", tid),
        "author": u.get("screen_name"),
        "author_name": u.get("name"),
        "verified": bool(u.get("verified") or u.get("is_blue_verified")),
        "created_at": d.get("created_at"),
        "text": d.get("text", ""),
        "likes": d.get("favorite_count"),
        "replies": d.get("conversation_count"),
        "reply_to": d.get("in_reply_to_screen_name"),
        "parent_id": (d.get("parent") or {}).get("id_str"),
        "url": f"https://x.com/{u.get('screen_name')}/status/{tid}",
        "engine": "synd",
    }


